---
interface Props {
	title?: string;
}
const { title = "Maci App" } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href={`${base}favicon.png`} />
		<meta name="generator" content={Astro.generator} />
		<meta name="tiktok-developers-site-verification" content="oUUvEQiTPacsZCWzggcvzj02ohVayi9U" />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--bg: #fafaff;
		--card: #ffffff;
		--border: #ebe9f7;
		--text: #16151f;
		--text-dim: #6b6b80;
		--primary: #7c3aed;
		--primary-light: #a78bfa;
		--accent: #06b6d4;
	}
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
		background: var(--bg);
		color: var(--text);
		scroll-behavior: smooth;
	}
</style>
