---
const features = [
  { icon: "📢", title: "Campañas sociales" },
  { icon: "📊", title: "Ranking en tiempo real" },
  { icon: "⭐", title: "Sistema de puntos" },
  { icon: "🔔", title: "Notificaciones" },
  { icon: "🎁", title: "Premios" },
  { icon: "👤", title: "Perfil de usuario" },
];
---
<section id="caracteristicas" class="features">
  <span class="eyebrow">Características</span>
  <h2>Todo lo que necesita una campaña</h2>
  <div class="grid">
    {
      features.map((f) => (
        <div class="card">
          <div class="icon">{f.icon}</div>
          <p>{f.title}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  .features {
    max-width: 1000px;
    margin: 0 auto;
    padding: 70px 20px;
    text-align: center;
  }
  .eyebrow {
    display: inline-block;
    color: var(--primary);
    font-size: 12px;
    letter-spacing: 1.5px;
    font-weight: 700;
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  h2 {
    font-size: 30px;
    margin: 0 0 40px;
    letter-spacing: -0.01em;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 18px;
  }
  .card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 26px 18px;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 30px rgba(124, 58, 237, 0.12);
  }
  .icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, rgba(124, 58, 237, 0.12), rgba(6, 182, 212, 0.12));
    border-radius: 12px;
    margin: 0 auto 14px;
    font-size: 20px;
  }
  .card p {
    font-weight: 600;
    margin: 0;
  }
</style>
