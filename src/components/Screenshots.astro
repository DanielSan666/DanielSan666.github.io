---
import { Image } from "astro:assets";
import login from "../assets/screenshots/login.jpg";
import home from "../assets/screenshots/home.jpg";
import campaigns from "../assets/screenshots/campaings.jpg";
import ranking from "../assets/screenshots/ranking.jpg";
import profile from "../assets/screenshots/profile.jpg";
import notifications from "../assets/screenshots/notifications.jpg";

const screens = [
  { name: "Login", src: login },
  { name: "Home", src: home },
  { name: "Campañas", src: campaigns },
  { name: "Ranking", src: ranking },
  { name: "Perfil", src: profile },
  { name: "Notificaciones", src: notifications },
];
---

<section id="capturas" class="screenshots">
  <span class="eyebrow">Capturas</span>
  <h2>Así se siente MACI</h2>
  <p class="subtitle">Explora cada pantalla y descubre cómo funciona la app.</p>

  <div class="coverflow" id="coverflow">
    <button class="nav prev" aria-label="Anterior">‹</button>
    <div class="track" id="track">
      {
        screens.map((screen) => (
          <div class="phone" data-name={screen.name}>
            <Image
              src={screen.src}
              alt={screen.name}
              width={280}
              height={606}
            />
          </div>
        ))
      }
    </div>
    <button class="nav next" aria-label="Siguiente">›</button>
  </div>

  <div class="tabs" id="tabs">
    {
      screens.map((screen, i) => (
        <button class="tab" data-index={i}>
          {screen.name}
        </button>
      ))
    }
  </div>
</section>

<style>
  .screenshots {
    max-width: 1100px;
    margin: 0 auto;
    padding: 70px 20px;
    text-align: center;
  }
  .eyebrow {
    display: inline-block;
    color: var(--primary);
    font-size: 12px;
    letter-spacing: 1.5px;
    font-weight: 700;
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  h2 {
    font-size: 30px;
    margin: 0 0 10px;
    letter-spacing: -0.01em;
  }
  .subtitle {
    color: var(--text-dim);
    margin-bottom: 20px;
  }
  .coverflow {
    position: relative;
    display: flex;
    align-items: center;
  }
  .track {
    display: flex;
    align-items: center;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 40px calc(50% - 110px);
    scrollbar-width: none;
  }
  .track::-webkit-scrollbar {
    display: none;
  }
  .phone {
    flex: 0 0 auto;
    width: 220px;
    scroll-snap-align: center;
    transition:
      transform 0.35s ease,
      opacity 0.35s ease,
      filter 0.35s ease;
    transform: scale(0.75);
    opacity: 0.35;
    filter: blur(1px);
  }
  .phone.active {
    transform: scale(1);
    opacity: 1;
    filter: blur(0);
  }
  .phone img {
    width: 100%;
    height: auto;
    border-radius: 28px;
    border: 6px solid #16151f;
    display: block;
    background: #fff;
    box-shadow: 0 20px 40px rgba(124, 58, 237, 0.12);
  }
  .phone.active img {
    box-shadow: 0 24px 50px rgba(124, 58, 237, 0.25);
  }
  .nav {
    position: absolute;
    z-index: 2;
    top: 45%;
    transform: translateY(-50%);
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--primary);
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.06);
  }
  .nav:hover {
    border-color: var(--primary-light);
  }
  .nav.prev {
    left: 0;
  }
  .nav.next {
    right: 0;
  }
  .tabs {
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 10px;
  }
  .tab {
    background: var(--card);
    border: 1px solid var(--border);
    color: var(--text-dim);
    font-size: 12px;
    padding: 7px 16px;
    border-radius: 999px;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .tab.active {
    background: var(--primary) linear-gradient(90deg, var(--primary), var(--primary-light));
    color: #fff;
    border-color: transparent;
    font-weight: 600;
  }
</style>

<script>
  const track = document.getElementById("track");
  const coverflow = document.getElementById("coverflow");
  const tabs = document.getElementById("tabs");
  if (track && coverflow && tabs) {
    const phones = Array.from(
      track.querySelectorAll(".phone"),
    ) as HTMLElement[];
    const tabButtons = Array.from(
      tabs.querySelectorAll(".tab"),
    ) as HTMLElement[];

    const updateActive = () => {
      const center = track.scrollLeft + track.clientWidth / 2;
      let closestIndex = 0;
      let closestDist = Infinity;
      phones.forEach((phone, i) => {
        const dist = Math.abs(
          phone.offsetLeft + phone.offsetWidth / 2 - center,
        );
        if (dist < closestDist) {
          closestDist = dist;
          closestIndex = i;
        }
      });
      phones.forEach((p, i) =>
        p.classList.toggle("active", i === closestIndex),
      );
      tabButtons.forEach((t, i) =>
        t.classList.toggle("active", i === closestIndex),
      );
    };

    track.addEventListener("scroll", updateActive, { passive: true });
    updateActive();

    coverflow.querySelector(".prev")?.addEventListener("click", () => {
      track.scrollBy({ left: -240, behavior: "smooth" });
    });
    coverflow.querySelector(".next")?.addEventListener("click", () => {
      track.scrollBy({ left: 240, behavior: "smooth" });
    });
    tabButtons.forEach((tab, i) => {
      tab.addEventListener("click", () => {
        phones[i].scrollIntoView({
          behavior: "smooth",
          inline: "center",
          block: "nearest",
        });
      });
    });
  }
</script>
