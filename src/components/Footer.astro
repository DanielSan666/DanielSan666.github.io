---
const year = new Date().getFullYear();
---

<footer class="footer">
  <p class="about">
    MACI es una plataforma desarrollada por Maxtres para administrar campañas de
    interacción en redes sociales entre empresas y usuarios.
  </p>
  <div class="links">
    <a href="/privacy">Privacy Policy</a>
    <a href="/terms">Terms of Service</a>
    <a href="mailto:support@maxtres.org">saci97703@gmail.com</a>
  </div>
  <p class="copy">© {year} MACI</p>
</footer>

<style>
  .footer {
    text-align: center;
    padding: 50px 20px;
    border-top: 1px solid var(--border);
    color: var(--text-dim);
  }
  .about {
    max-width: 560px;
    margin: 0 auto 18px;
    font-size: 13px;
    line-height: 1.6;
  }
  .links {
    display: flex;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }
  .links a {
    color: var(--primary);
    text-decoration: none;
    font-size: 13px;
  }
  .links a:hover {
    text-decoration: underline;
  }
  .copy {
    font-size: 12px;
    color: var(--text-dim);
    margin: 0;
  }
</style>
